// Writes the 8 corners of a unit cube centered at the origin, transformed like
// TransformPosition.comp: scaled by 'scale', then 'shift' added to z.
// Compiled to SPIR-V at build time (see CMakeLists.txt) and embedded in the plugin.
#version 450

layout(local_size_x = 8) in;

// Tightly packed 3-component floats, 3 per point (see TransformPosition.comp).
layout(std430, set = 0, binding = 0) writeonly buffer OutP { float outP[]; };

// Must match PositionParams in VulkanPOP.cpp; only scale and shift are used.
layout(push_constant) uniform Params
{
	uint  maxPoints;
	float scale;
	float shift;
	uint  numPointsOnGPU;
	uint  numPoints;
} p;

void main()
{
	const uint id = gl_GlobalInvocationID.x;
	if (id >= 8)
		return;

	// Corner id is at (x, y, z) = (bit0, bit1, bit2) mapped to -0.5 / +0.5.
	const vec3 corner = vec3((id & 1u) != 0u ? 0.5 : -0.5,
							 (id & 2u) != 0u ? 0.5 : -0.5,
							 (id & 4u) != 0u ? 0.5 : -0.5);
	const vec3 v = corner * p.scale + vec3(0.0, 0.0, p.shift);

	outP[id * 3 + 0] = v.x;
	outP[id * 3 + 1] = v.y;
	outP[id * 3 + 2] = v.z;
}
